# Audiobook Generator - ROCm (AMD GPU) Docker build
# Supports AMD GPU acceleration for TTS via ROCm with Flash Attention (Triton backend)

FROM rocm/pytorch:latest AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies including sox for qwen-tts
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    sox \
    libsox-dev \
    git \
    ninja-build \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Triton for ROCm Flash Attention
RUN pip install --no-cache-dir triton==3.2.0

# Build Flash Attention with Triton backend for ROCm
ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
RUN git clone https://github.com/Dao-AILab/flash-attention.git /tmp/flash-attention \
    && cd /tmp/flash-attention \
    && python setup.py install \
    && rm -rf /tmp/flash-attention

# Create app user for security (use different UID since 1000 may be taken in base image)
RUN useradd -m -u 1001 appuser || true

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies (skip torch since it's pre-installed in base image)
# Include build tools for runtime flash-attn installation
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
    soundfile \
    numpy \
    qwen-tts \
    transformers \
    accelerate \
    requests \
    pydub \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    sqlalchemy \
    aiosqlite \
    pyyaml \
    pydantic \
    python-dotenv \
    tqdm \
    packaging \
    wheel \
    setuptools

# Copy application code
COPY src/ ./src/
COPY frontend/ ./frontend/
COPY run_server.py .
COPY config.sample.yml .
COPY docker-entrypoint.sh .

# Create data directories and set permissions
RUN mkdir -p /app/data/input /app/data/output /app/data/temp \
    && chmod +x /app/docker-entrypoint.sh \
    && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
# Numba cache directory (fixes librosa caching issue)
ENV NUMBA_CACHE_DIR=/tmp/numba_cache
# Enable Flash Attention Triton backend for ROCm
ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
# Skip runtime flash-attn install (already built)
ENV INSTALL_FLASH_ATTN=false

# Expose port
EXPOSE 8000

# Health check (longer start period for flash-attn installation)
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/stats')" || exit 1

# Entrypoint installs Flash Attention if GPU available
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Default command
CMD ["python", "run_server.py"]
