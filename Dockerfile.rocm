# Audiobook Generator - ROCm (AMD GPU) Docker build
# Supports AMD GPU acceleration for TTS via ROCm
# Uses custom PyTorch wheels for gfx1151 (Radeon 8060S/RDNA 3.5) support
# See: https://github.com/ROCm/TheRock/discussions/655

FROM rocm/dev-ubuntu-24.04:6.4.1 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies including sox for qwen-tts and Python 3.11
# The gfx1151 PyTorch wheel is built for Python 3.11, not 3.12
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    sox \
    libsox-dev \
    git \
    ninja-build \
    build-essential \
    gosu \
    curl \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

# Install custom PyTorch wheel with gfx1151 support from TheRock project
# These wheels are built specifically for RDNA 3.5 (gfx1151) GPUs - Python 3.11 only
RUN pip install --no-cache-dir --break-system-packages \
    https://github.com/scottt/rocm-TheRock/releases/download/v6.5.0rc-pytorch/torch-2.7.0a0+gitbfd8155-cp311-cp311-linux_x86_64.whl

# Create app user for security (use different UID since 1000 may be taken in base image)
# Add to video and render groups for GPU access
RUN useradd -m -u 1001 -G video,render appuser || true

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies (skip pip upgrade - system pip works fine)
RUN pip install --no-cache-dir --break-system-packages \
    soundfile \
    numpy \
    transformers \
    accelerate \
    requests \
    pydub \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    sqlalchemy \
    aiosqlite \
    pyyaml \
    pydantic \
    python-dotenv \
    tqdm \
    packaging \
    wheel \
    setuptools \
    ninja

# Install qwen-tts separately to ensure it succeeds
# Note: Do NOT install flash_attn for ROCm - qwen_tts has a hard import that crashes
# when flash_attn is installed but no GPU is available at import time.
# qwen_tts will use standard attention as fallback.
RUN pip install --no-cache-dir --break-system-packages qwen-tts

# Copy application code
COPY src/ ./src/
COPY frontend/ ./frontend/
COPY run_server.py .
COPY config.sample.yml .
COPY docker-entrypoint.sh .

# Create data directories, cache directories, and set permissions
RUN mkdir -p /app/data/input /app/data/output /app/data/temp \
    && mkdir -p /home/appuser/.cache/huggingface \
    && chmod +x /app/docker-entrypoint.sh \
    && chown -R appuser:appuser /app \
    && chown -R appuser:appuser /home/appuser/.cache

# NOTE: We start as root to fix GPU permissions in entrypoint, then drop to appuser
# USER appuser is handled by the entrypoint script after fixing permissions

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
# Hugging Face cache directory
ENV HF_HOME=/home/appuser/.cache/huggingface
# Numba cache directory (fixes librosa caching issue)
ENV NUMBA_CACHE_DIR=/tmp/numba_cache
# Skip runtime flash-attn install (not compatible with ROCm in qwen_tts)
ENV INSTALL_FLASH_ATTN=false

# Expose port
EXPOSE 8000

# Health check (longer start period for flash-attn installation)
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/stats')" || exit 1

# Entrypoint installs Flash Attention if GPU available
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Default command
CMD ["python", "run_server.py"]
