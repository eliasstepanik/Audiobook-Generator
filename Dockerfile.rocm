# Audiobook Generator - ROCm (AMD GPU) Docker build
# Supports AMD GPU acceleration for TTS via ROCm

FROM rocm/pytorch:latest AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app user for security
RUN useradd -m -u 1000 appuser

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies (skip torch since it's pre-installed in base image)
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
    soundfile \
    numpy \
    qwen-tts \
    transformers \
    accelerate \
    requests \
    pydub \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    sqlalchemy \
    aiosqlite \
    pyyaml \
    pydantic \
    python-dotenv \
    tqdm

# Copy application code
COPY src/ ./src/
COPY frontend/ ./frontend/
COPY run_server.py .
COPY config.sample.yml .

# Create data directories
RUN mkdir -p /app/data/input /app/data/output /app/data/temp \
    && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/stats')" || exit 1

# Default command
CMD ["python", "run_server.py"]
