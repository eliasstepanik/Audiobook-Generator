# Audiobook Generator - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration
# =============================================================================

# LLM Provider: ollama, openai, or anthropic
LLM_PROVIDER=openai

# Model name for the selected provider
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-sonnet-4-20250514, claude-3-opus-20240229
# Ollama: llama3:70b, mistral, etc.
LLM_MODEL=gpt-4o

# API Base URL (required for Ollama, optional for OpenAI/Anthropic)
# OpenAI default: https://api.openai.com/v1
# Anthropic default: https://api.anthropic.com
# Ollama default: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# API Key (required for OpenAI and Anthropic)
LLM_API_KEY=sk-your-api-key-here

# Request timeout in seconds
LLM_TIMEOUT=600

# Temperature for LLM responses (0.0-1.0)
LLM_TEMPERATURE=0.1

# =============================================================================
# TTS Configuration
# =============================================================================

# Device for TTS inference
# Options: cuda:0, cuda:1, cpu, or leave empty for auto-detect
TTS_DEVICE=

# Data type for model weights
# Options: bfloat16, float16, float32
TTS_DTYPE=bfloat16

# Flash Attention (faster inference)
# Options: true, false, or leave empty for auto-detect
TTS_USE_FLASH_ATTENTION=

# Default language for voice synthesis
TTS_LANGUAGE=English

# =============================================================================
# Text Processing
# =============================================================================

# Maximum characters per batch
MAX_CHARS_PER_BATCH=16000

# =============================================================================
# Application Settings
# =============================================================================

# Server host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# Debug mode (true/false)
APP_DEBUG=false

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite database URL
DATABASE_URL=sqlite:///audiobook_jobs.db
