# Ollama Configuration
OLLAMA_MODEL=gpt-oss-16k:120b
OLLAMA_BASE_URL=https://192.168.178.166/v1
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT=300

# TTS Configuration
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
TTS_BATCH_SIZE=5
TTS_FLASH_ATTENTION=true

# Voice Design
VOICE_DESIGN_TEXT=Hello, welcome to this audiobook. I hope you enjoy the story.
VOICE_DESIGN_INSTRUCT=Male, 30 years old, clear and warm narrator voice, professional tone
VOICE_LANGUAGE=English

# Processing
MAX_CHARS_PER_BATCH=16000
ENABLE_OLLAMA=true
SAVE_INTERMEDIATE=false

# Server
API_HOST=0.0.0.0
API_PORT=8000
